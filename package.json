{
  "name": "invoice-extractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch backend/scripts/local-server.ts",
    "sandbox": "ampx sandbox",
    "sandbox:delete": "ampx sandbox delete",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p amplify/tsconfig.json --noEmit",
    "lint": "npm run typecheck && eslint .",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@tanstack/react-query": "^5.59.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ulid": "^2.3.0",
    "unpdf": "^0.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.16.1",
    "@aws-amplify/backend-cli": "^1.7.2",
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "tar": "^7.5.21",
    "mysql2": "^3.22.0",
    "immutable": "^3.8.4",
    "lodash": "^4.18.0"
  }
}
